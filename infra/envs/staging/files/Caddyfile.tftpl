# Staging edge (ADR 0034). One catch-all HTTPS site with on-demand TLS: Caddy gets a Let's Encrypt
# certificate per host name the first time it's asked for, through the HTTP-01 challenge on port 80.
# Port 80 otherwise only redirects to HTTPS (CR-4).
#
# The ask endpoint allows certificates only for our two base domains, or anyone pointing their DNS
# at this address could make us request certificates for theirs and use up the rate limit.
{
	on_demand_tls {
		ask http://127.0.0.1:9999/check
	}
}

http://127.0.0.1:9999 {
	bind 127.0.0.1
	@ours expression `{query.domain}.endsWith(".${staff_base}") || {query.domain} == "${staff_base}" || {query.domain}.endsWith(".${mandir_base}") || {query.domain} == "${mandir_base}"`
	handle @ours {
		respond 200
	}
	respond "not our zone" 403
}

https:// {
	tls {
		on_demand
	}
	# One HSTS header, set here for every response (the app's own copy is dropped): two headers
	# meant browsers obeyed only the first, weaker one (staging DAST, 2026-10-15).
	header Strict-Transport-Security "max-age=63072000; includeSubDomains"
	encode gzip
	reverse_proxy ${app_ip}:3000 {
		header_down -Strict-Transport-Security
	}
}
