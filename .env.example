# Copy to .env (gitignored) and fill in. NEVER commit real secrets.
# docker-compose and the backend both read these.
DB_NAME=sevacenter
DB_USERNAME=sevacenter
DB_PASSWORD=change-me-in-local-dev
DB_URL=jdbc:postgresql://localhost:5432/sevacenter  # trufflehog:ignore — no credentials in URL
# App runtime role (least-privilege; created by docker/db-init). Local dev only.
DB_APP_USERNAME=sevacenter_app
DB_APP_PASSWORD=change-me-app-role
# Donor PAN protection (ADR 0012): two DIFFERENT 32-byte keys. Generate each with:
#   openssl rand -base64 32
# The app refuses to start without them. Production keys come from the secret manager / KMS (M6).
SEVACENTER_PAN_KEY=
SEVACENTER_PAN_INDEX_KEY=
# Encrypts credentials trusts connect, e.g. their Razorpay key secret (ADR 0013). Another
# DIFFERENT 32-byte key: openssl rand -base64 32
SEVACENTER_SECRETS_KEY=
# Optional, local only: your own Razorpay TEST keys, used by the opt-in RazorpayGatewayLiveTest.
# Trusts connect their own keys in the app (Payments); these are never read by the app itself.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
